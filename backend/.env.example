# Optional: card payments via Stripe Checkout. Leave blank to hide the
# "Card" option at checkout. NOTE: Stripe does not support Pakistan as a
# merchant country — this only works if your Stripe account is registered
# in a country Stripe supports and PKR is enabled as a presentment
# # currency. Confirm with Stripe support before relying on this live.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# # Optional: JazzCash Web Checkout (wallet/card). Leave blank to fall back
# # to manual JazzCash payment instructions at checkout. Get these from your
# # JazzCash merchant onboarding — field names/version should be confirmed
# # against the integration guide your JazzCash account manager provides.
# JAZZCASH_MODE=sandbox
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=

